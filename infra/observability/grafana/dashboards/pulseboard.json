        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"api-core\"}[$__rate_interval])) / clamp_min(sum by (uri) (rate(http_server_requests_seconds_count{job=\"api-core\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "pulseboard-prometheus"
          }
        }
      ]
    },
