# Copy to .env and set every empty value before running `make up`.
# Generate secrets with: openssl rand -base64 32
# Compose rejects missing or empty database passwords, including those below.

POSTGRES_DB=pulseboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
API_CORE_DB_PASSWORD=
ANALYTICS_READER_DB_PASSWORD=
ANALYTICS_WRITER_DB_PASSWORD=

# Redis password (required). Use URL-safe characters only, e.g. `openssl rand -hex 24`.
REDIS_PASSWORD=

# HMAC key shared by api-core and analytics (X-Internal-Signature)
INTERNAL_SHARED_SECRET=
# JWT signing key for api-core (at least 32 bytes)
JWT_SECRET=

# Host port of the web entry point (nginx). Not related to the api-core management port 8081,
# which exists only inside the Docker network.
WEB_PORT=8081


# Development web proxy target inside the Compose network.
API_PROXY_TARGET=http://api-core:8080

# Optional host port overrides for `make up DEV=1` (defaults shown)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# WEB_DEV_PORT=4200
# API_CORE_HOST_PORT=8080
