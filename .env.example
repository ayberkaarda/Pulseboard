# Copy to .env and set every empty value before running `make up`.
# Generate secrets with: openssl rand -base64 32
# Compose rejects missing or empty database passwords, including those below.

POSTGRES_DB=pulseboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
API_CORE_DB_PASSWORD=
ANALYTICS_READER_DB_PASSWORD=
ANALYTICS_WRITER_DB_PASSWORD=

# Redis password (required). Use URL-safe characters only, e.g. `openssl rand -hex 24`.
REDIS_PASSWORD=

# HMAC key shared by api-core and analytics (X-Internal-Signature). At least 32 characters;
# both services refuse to start otherwise. Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=
# JWT signing key for api-core (at least 32 bytes)
JWT_SECRET=

# Host port of the web entry point (nginx). Not related to the api-core management port 8081,
# which exists only inside the Docker network.
WEB_PORT=8081


# Development web proxy target inside the Compose network.
API_PROXY_TARGET=http://api-core:8080

# Optional host port overrides for `make up DEV=1` (defaults shown)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# WEB_DEV_PORT=4200
# API_CORE_HOST_PORT=8080

# Analytics scheduler (runs in the analytics process; keep exactly one replica)
# SCHEDULER_ENABLED=true
# SCORE_INTERVAL_SECONDS=60
# Lease (Redis lock) lifetime in milliseconds; the deadline and the margin must each stay shorter
# SCORE_LOCK_TTL_MS=55000
# Time budget of one scoring run; must stay below the lock TTL
# SCORE_DEADLINE_SECONDS=50
# Safety margin kept before the lease expires (seconds)
# SCORE_LEASE_MARGIN_SECONDS=5
# Longest wait for a per-metric lock before the metric is skipped (seconds)
# METRIC_LOCK_TIMEOUT_SECONDS=10
# Longest wait for a free database connection, and for opening one (seconds; both also bounded by the run budget)
# DB_POOL_TIMEOUT_SECONDS=5
# DB_CONNECT_TIMEOUT_SECONDS=5
# Maximum number of fitted Isolation Forest models kept in memory
# FOREST_CACHE_MAX=256
# Refuse to start when the database roles hold more or fewer privileges than expected
# VERIFY_DB_ROLES=true

# Optional api-core limits for the live anomaly stream and the internal endpoint (defaults shown)
# ANOMALY_STREAM_MAX_PER_TENANT=10
# ANOMALY_STREAM_MAX_TOTAL=500
# ANOMALY_STREAM_HEARTBEAT=30s
# ANOMALY_STREAM_MAX_LIFETIME=30m
# INTERNAL_MAX_BODY_BYTES=524288
# One-time stream tickets: lifetime and how many one user may request per period
# STREAM_TICKET_TTL=30s
# STREAM_TICKET_ISSUE_CAPACITY=30
# STREAM_TICKET_ISSUE_PERIOD=1m
# Absolute session lifetime counted from login (Spring duration, must be at least the 7d refresh token TTL)
# REFRESH_FAMILY_TTL=30d
